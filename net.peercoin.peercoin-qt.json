{
  "id": "net.peercoin.peercoin-qt",
  "runtime": "org.kde.Platform",
  "runtime-version": "6.11",
  "sdk": "org.kde.Sdk",
  "command": "peercoin-qt",
  "finish-args": [
    "--share=ipc",
    "--share=network",
    "--socket=wayland",
    "--socket=fallback-x11",
    "--device=dri",
    "--talk-name=org.freedesktop.Notifications",
    "--talk-name=org.kde.StatusNotifierWatcher"
  ],
  "cleanup": [
    "/include",
    "/lib/cmake",
    "/lib/pkgconfig",
    "/share/aclocal",
    "/share/doc",
    "/share/man",
    "*.a",
    "*.la"
  ],
  "modules": [
    {
      "name": "boost",
      "buildsystem": "cmake-ninja",
      "builddir": true,
      "config-opts": [
        "-DBOOST_INCLUDE_LIBRARIES=multi_index;signals2",
        "-DBOOST_ENABLE_MPI=OFF",
        "-DBOOST_ENABLE_PYTHON=OFF",
        "-DBOOST_INSTALL_LAYOUT=system",
        "-DBUILD_TESTING=OFF"
      ],
      "sources": [
        {
          "type": "archive",
          "url": "https://github.com/boostorg/boost/releases/download/boost-1.90.0/boost-1.90.0-cmake.tar.gz",
          "sha256": "913ca43d49e93d1b158c9862009add1518a4c665e7853b349a6492d158b036d4"
        }
      ]
    },
    {
      "name": "libevent",
      "buildsystem": "cmake-ninja",
      "builddir": true,
      "config-opts": [
        "-DCMAKE_POLICY_VERSION_MINIMUM=3.5",
        "-DEVENT__DISABLE_BENCHMARK=ON",
        "-DEVENT__DISABLE_OPENSSL=ON",
        "-DEVENT__DISABLE_REGRESS=ON",
        "-DEVENT__DISABLE_SAMPLES=ON",
        "-DEVENT__DISABLE_TESTS=ON",
        "-DEVENT__LIBRARY_TYPE=SHARED"
      ],
      "sources": [
        {
          "type": "archive",
          "url": "https://github.com/libevent/libevent/releases/download/release-2.1.13-stable/libevent-2.1.13-stable.tar.gz",
          "sha256": "f7e9383b8c0baa81b687e5b5eecc01beefaf1b19b64151d95ed61647fe7a315c"
        }
      ]
    },
    {
      "name": "peercoin",
      "buildsystem": "cmake-ninja",
      "builddir": true,
      "config-opts": [
        "-DCMAKE_BUILD_TYPE=RelWithDebInfo",
        "-DBUILD_BITCOIN_BIN=OFF",
        "-DBUILD_GUI=ON",
        "-DBUILD_DAEMON=OFF",
        "-DBUILD_CLI=OFF",
        "-DBUILD_TESTS=OFF",
        "-DBUILD_TX=OFF",
        "-DBUILD_UTIL=OFF",
        "-DBUILD_BENCH=OFF",
        "-DENABLE_IPC=OFF",
        "-DWITH_ZMQ=OFF",
        "-DWITH_USDT=OFF",
        "-DWITH_QRENCODE=ON",
        "-DWITH_DBUS=ON",
        "-DWITH_CCACHE=OFF",
        "-DINSTALL_MAN=OFF"
      ],
      "post-install": [
        "install -d /app/libexec",
        "mv /app/bin/peercoin-qt /app/libexec/peercoin-qt",
        "install -Dm755 ${FLATPAK_BUILDER_BUILDDIR}/peercoin-qt-wrapper /app/bin/peercoin-qt",
        "install -Dm644 ${FLATPAK_BUILDER_BUILDDIR}/net.peercoin.peercoin-qt.desktop /app/share/applications/net.peercoin.peercoin-qt.desktop",
        "install -Dm644 ${FLATPAK_BUILDER_BUILDDIR}/net.peercoin.peercoin-qt.metainfo.xml /app/share/metainfo/net.peercoin.peercoin-qt.metainfo.xml",
        "install -Dm644 ${FLATPAK_BUILDER_BUILDDIR}/src/qt/res/src/bitcoin.svg /app/share/icons/hicolor/scalable/apps/net.peercoin.peercoin-qt.svg"
      ],
      "sources": [
        {
          "type": "git",
          "url": "https://github.com/peerchemist/peercoin.git",
          "commit": "4e10237cf189c27b3b2c21b22901cc1385c40c20"
        },
        {
          "type": "file",
          "path": "peercoin-qt-wrapper"
        },
        {
          "type": "file",
          "path": "net.peercoin.peercoin-qt.desktop"
        },
        {
          "type": "file",
          "path": "net.peercoin.peercoin-qt.metainfo.xml"
        }
      ]
    }
  ]
}